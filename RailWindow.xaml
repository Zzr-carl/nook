<Window x:Class="Nook.RailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nook"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="200" Height="15"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextRenderingMode="Grayscale">

    <Grid x:Name="Root" Background="Transparent">
        <Border x:Name="Shell" CornerRadius="0,0,11,11">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F00B0C0E" Offset="0" />
                    <GradientStop Color="#E614151A" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border CornerRadius="0,0,11,11" BorderThickness="0,0,1,1"
                BorderBrush="{StaticResource Hairline}" IsHitTestVisible="False" />

        <StackPanel x:Name="Ticks" Orientation="Horizontal"
                    VerticalAlignment="Top" Margin="12,0,0,0" />

        <!-- 拖动排序时的插入位指示 -->
        <Border x:Name="DragMarker" Width="2" Height="15" CornerRadius="1"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{StaticResource Accent}" Visibility="Collapsed"
                IsHitTestVisible="False" />
    </Grid>
</Window>
