<Window x:Class="Nook.DrawerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Nook"
        Title="Nook"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Width="680" Height="500"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale">

    <Grid x:Name="RootGrid" Background="Transparent"
          MouseRightButtonDown="Panel_MouseRightButtonDown">

        <Border x:Name="GlassShell" CornerRadius="24" Background="Transparent">
            <Grid>
                <Image x:Name="Backdrop" Stretch="Fill" IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Border Background="{StaticResource Veil}" IsHitTestVisible="False" />
                <Border Background="{StaticResource Specular}" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Border x:Name="HairlineBorder" CornerRadius="24" BorderThickness="1"
                BorderBrush="{StaticResource Hairline}" IsHitTestVisible="False" />

        <!-- ================= 展开态 ================= -->
        <Grid x:Name="ExpandedLayer" Visibility="Collapsed" Opacity="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="AccentBar" Grid.Column="0" Width="3" Height="15" CornerRadius="2"
                        Margin="22,2,11,0" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFE9B872" Offset="0" />
                            <GradientStop Color="#80E9B872" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,2,0,0">
                    <TextBlock x:Name="TitleText" Text="抽屉"
                               FontFamily="{StaticResource Display}" FontSize="16.5"
                               Foreground="{StaticResource InkStrong}" TextTrimming="CharacterEllipsis"
                               MouseLeftButtonDown="TitleText_Click" Cursor="Hand" />
                    <TextBox x:Name="TitleEditor" Visibility="Collapsed"
                             FontFamily="{StaticResource Display}" FontSize="16.5"
                             Foreground="{StaticResource InkStrong}" Background="#14FFFFFF"
                             BorderThickness="0" Padding="4,1" CaretBrush="{StaticResource Accent}"
                             SelectionBrush="{StaticResource AccentSoft}"
                             MaxLength="24" KeyDown="TitleEditor_KeyDown" LostFocus="TitleEditor_LostFocus" />
                    <TextBlock x:Name="SubTitleText" Text="0 项"
                               FontFamily="{StaticResource Mono}" FontSize="10"
                               Foreground="{StaticResource InkFaint}" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Column="2" x:Name="MenuBtn" Width="30" Height="30" CornerRadius="9"
                        Background="Transparent" VerticalAlignment="Center" Margin="0,0,16,0"
                        MouseLeftButtonDown="MenuBtn_Click" Cursor="Hand">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#14FFFFFF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="3" Height="3" Fill="{StaticResource InkSoft}" />
                        <Ellipse Width="3" Height="3" Fill="{StaticResource InkSoft}" Margin="3,0,0,0" />
                        <Ellipse Width="3" Height="3" Fill="{StaticResource InkSoft}" Margin="3,0,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer x:Name="ItemsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,10"
                          Padding="16,0,8,0" Focusable="False">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                </ScrollViewer.Resources>

                <Grid>
                <ItemsControl x:Name="ItemsHost">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:DrawerItem}">
                            <Border x:Name="Card" Width="{Binding Metrics.CardWidth}"
                                    Height="{Binding Metrics.CardHeight}" Margin="1"
                                    CornerRadius="{Binding Metrics.Radius}"
                                    Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                                    MouseMove="Card_MouseMove"
                                    MouseLeftButtonUp="Card_MouseLeftButtonUp"
                                    MouseRightButtonDown="Card_MouseRightButtonDown">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#10FFFFFF" />
                                                <Setter Property="BorderBrush" Value="#14FFFFFF" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="#1AE9B872" />
                                                <Setter Property="BorderBrush" Value="#44E9B872" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter Property="Opacity" Value="0.32" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAddTile}" Value="True">
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="BorderBrush" Value="#1FFFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel VerticalAlignment="Top" Margin="{Binding Metrics.IconTopMargin}">
                                    <Grid Width="{Binding Metrics.IconSide}" Height="{Binding Metrics.IconSide}"
                                          Margin="{Binding Metrics.IconMargin}">
                                        <Image x:Name="Ico" Source="{Binding Icon}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAddTile}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <Grid x:Name="Plus" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAddTile}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Rectangle Width="{Binding Metrics.PlusSide}" Height="1.6" RadiusX="1"
                                                       Fill="{StaticResource InkSoft}" />
                                            <Rectangle Width="1.6" Height="{Binding Metrics.PlusSide}" RadiusX="1"
                                                       Fill="{StaticResource InkSoft}" />
                                        </Grid>
                                    </Grid>
                                    <TextBlock x:Name="Label" Text="{Binding Name}"
                                               FontFamily="{StaticResource Display}"
                                               FontSize="{Binding Metrics.LabelFont}"
                                               Foreground="{StaticResource InkSoft}"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="{Binding Metrics.LabelMaxHeight}"
                                               LineHeight="{Binding Metrics.LineHeight}"
                                               LineStackingStrategy="BlockLineHeight"
                                               Margin="{Binding Metrics.LabelPadding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Canvas x:Name="MarkerLayer" IsHitTestVisible="False">
                    <Border x:Name="InsertMarker" Width="2.5" Height="78" CornerRadius="1.5"
                            Background="{StaticResource Accent}" Visibility="Collapsed" Opacity="0.9" />
                </Canvas>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 拖入反馈 -->
        <Border x:Name="DropHint" CornerRadius="23" BorderThickness="1.5"
                BorderBrush="#59E9B872" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</Window>
