<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 字体 ============ -->
    <FontFamily x:Key="Display">pack://application:,,,/Assets/Fonts/#Sora</FontFamily>
    <FontFamily x:Key="Mono">pack://application:,,,/Assets/Fonts/#JetBrains Mono</FontFamily>

    <!-- ============ 色板 · 石墨 + 琥珀 ============ -->
    <Color x:Key="InkColor">#F4F5F7</Color>
    <Color x:Key="AccentColor">#E9B872</Color>

    <SolidColorBrush x:Key="Ink" Color="#F4F5F7" />
    <SolidColorBrush x:Key="InkStrong" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InkSoft" Color="#9CF4F5F7" />
    <SolidColorBrush x:Key="InkFaint" Color="#5CF4F5F7" />
    <SolidColorBrush x:Key="Accent" Color="#E9B872" />
    <SolidColorBrush x:Key="AccentSoft" Color="#3DE9B872" />
    <SolidColorBrush x:Key="SurfaceSolid" Color="#131418" />

    <!-- 玻璃罩：压暗底噪，保证任意壁纸上的文字可读 -->
    <LinearGradientBrush x:Key="Veil" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#E20A0B0D" Offset="0" />
        <GradientStop Color="#DA0C0D11" Offset="0.55" />
        <GradientStop Color="#E8121317" Offset="1" />
    </LinearGradientBrush>

    <!-- 高光：只有明度变化，没有双色渐变 -->
    <LinearGradientBrush x:Key="Specular" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#1FFFFFFF" Offset="0" />
        <GradientStop Color="#0AFFFFFF" Offset="0.3" />
        <GradientStop Color="#00FFFFFF" Offset="0.62" />
        <GradientStop Color="#08FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Hairline" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38FFFFFF" Offset="0" />
        <GradientStop Color="#12FFFFFF" Offset="0.45" />
        <GradientStop Color="#0AFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ChipFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#18FFFFFF" Offset="0" />
        <GradientStop Color="#0CFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- ============ 细滚动条 ============ -->
    <Style x:Key="SlimThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Width="5" CornerRadius="3" Background="#30FFFFFF" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#55FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{StaticResource AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SlimThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 右键菜单 ============ -->
    <Style x:Key="NookMenuItem" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource Display}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="Dot" Grid.Column="0" Width="5" Height="5"
                                     Fill="{StaticResource Accent}" Visibility="Collapsed"
                                     VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NookSeparator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,5" Background="#12FFFFFF" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NookMenu" TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource Display}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource NookMenuItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border CornerRadius="12" Background="#F2141619" BorderBrush="#1AFFFFFF"
                            BorderThickness="1" Padding="5" Margin="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
