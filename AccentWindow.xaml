<Window Icon="Assets/nook.ico"
        x:Class="Nook.AccentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="主题色"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="340"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextRenderingMode="Grayscale">

    <Border CornerRadius="14" Background="#F2101216"
            BorderBrush="#26FFFFFF" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="18,14,18,16" MouseLeftButtonDown="TitleDrag">

            <Grid>
                <TextBlock Text="主题色" FontFamily="{StaticResource Display}" FontSize="14.5"
                           Foreground="{StaticResource InkStrong}" VerticalAlignment="Center" />
                <Button Content="✕" HorizontalAlignment="Right" Click="Close_Click"
                        FontSize="11" FontFamily="{StaticResource Mono}"
                        Background="Transparent" Foreground="{StaticResource InkFaint}"
                        BorderThickness="0" Cursor="Hand" Padding="6,2" />
            </Grid>

            <!-- 九个预设色板 -->
            <UniformGrid x:Name="Swatches" Columns="5" Rows="2" Margin="0,14,0,0" />

            <!-- 色号输入 -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="8" Background="#1AFFFFFF"
                        BorderBrush="#26FFFFFF" BorderThickness="1">
                    <TextBox x:Name="HexBox" Text="#E9B872"
                             FontFamily="{StaticResource Mono}" FontSize="12"
                             Background="Transparent" Foreground="{StaticResource InkStrong}"
                             BorderThickness="0" Padding="10,7" CaretBrush="{DynamicResource Accent}"
                             VerticalContentAlignment="Center"
                             KeyDown="HexBox_KeyDown" TextChanged="HexBox_TextChanged" />
                </Border>

                <Button Grid.Column="2" Content="应用" Click="ApplyHex_Click"
                        FontFamily="{StaticResource Display}" FontSize="11.5"
                        Background="{DynamicResource Accent}" Foreground="#141519"
                        BorderThickness="0" Padding="16,7" Cursor="Hand" />
            </Grid>

            <Button Content="从系统取色器挑选…" Click="Picker_Click"
                    FontFamily="{StaticResource Display}" FontSize="11.5"
                    Background="#1AFFFFFF" Foreground="{StaticResource Ink}"
                    BorderBrush="#26FFFFFF" BorderThickness="1" Padding="0,7" Margin="0,8,0,0" Cursor="Hand" />

            <!-- 当前效果预览 -->
            <Border x:Name="Preview" CornerRadius="8" Height="26" Margin="0,14,0,0" />

            <TextBlock x:Name="Hint" Text="点色板或输入 #RRGGBB，即时生效"
                       FontFamily="{StaticResource Mono}" FontSize="9.5"
                       Foreground="{StaticResource InkFaint}" Margin="0,10,0,0" />
        </StackPanel>
    </Border>
</Window>
